{
  "rewrites": [
    { "source": "/supabase/:path*", "destination": "/__not_public__" },
    { "source": "/SECURITY.md", "destination": "/__not_public__" },
    { "source": "/vercel.json", "destination": "/__not_public__" },
    { "source": "/admin", "destination": "/webazi-admin.html" },
    { "source": "/admin/", "destination": "/webazi-admin.html" },
    { "source": "/web-design", "destination": "/web-design.html" },
    { "source": "/seo-services", "destination": "/seo-services.html" },
    { "source": "/digital-marketing", "destination": "/digital-marketing.html" },
    { "source": "/graphic-design", "destination": "/graphic-design.html" }
  ],
  "headers": [
    { "source": "/intro.mp4", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/intro.webm", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://images.unsplash.com; media-src 'self'; connect-src 'self' https://ezyvuipabbhckplhlvxz.supabase.co wss://ezyvuipabbhckplhlvxz.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/webazi-admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
