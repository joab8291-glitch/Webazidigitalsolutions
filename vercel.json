{
  "rewrites": [
    { "source": "/admin", "destination": "/webazi-admin.html" },
    { "source": "/admin/", "destination": "/webazi-admin.html" }
  ],
  "headers": [
    { "source": "/intro.mp4", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/intro.webm", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}